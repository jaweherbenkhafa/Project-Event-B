        <org.eventb.core.prPred name="p396" org.eventb.core.predicate="Large ↦ Heavy∈dom(Separation_time)"/>
        <org.eventb.core.prPred name="p308" org.eventb.core.predicate="∀a⦂AIRCRAFTS,b⦂AIRCRAFTS·a∈dom(cpTime)∧b∈dom(cpTime)∧¬a=b∧a∈dom(brandof)∧b∈dom(brandof)∧cpOf(a)=cpOf(b)∧cpTime(a)≤cpTime(b)⇒cpTime(b) − cpTime(a)≥Separation_time(brandof(a) ↦ brandof(b))"/>
        <org.eventb.core.prPred name="p143" org.eventb.core.predicate="¬ScheduledL=ExecutedL"/>
        <org.eventb.core.prPred name="p7" org.eventb.core.predicate="clearanceT∈aircrafts_in_TMA ⇸ RUNWAY"/>
        <org.eventb.core.prPred name="p8" org.eventb.core.predicate="∀a⦂AIRCRAFTS·a∈dom(mergeTime)∧a∈dom(brandof)∧mergeTime(a)=lastMergeTime(PmsMerge(legPMS(legOf(a))))⇒brandof(a)=lastMergeBrand(PmsMerge(legPMS(legOf(a))))"/>
        <org.eventb.core.prPred name="p228" org.eventb.core.predicate="¬NIRIF=SUTEX"/>
        <org.eventb.core.prPred name="p374" org.eventb.core.predicate="¬SORIN=SUGAD"/>
        <org.eventb.core.prPred name="p392" org.eventb.core.predicate="Small ↦ Large∈dom(Separation_time)"/>
        <org.eventb.core.prPred name="p12" org.eventb.core.predicate="∀l1⦂SLEGS,l2⦂SLEGS,i1⦂ℤ,i2⦂ℤ·l1∈SLEGS∧l2∈SLEGS∧l1≠l2∧legPMS(l1)=legPMS(l2)∧i1∈1 ‥ leglength(l1)∧i2∈1 ‥ leglength(l2)∧wpDistMerge(legSeq(l1)(i1))&lt;wpDistMerge(legSeq(l2)(i2))⇒legFL(l1)&gt;legFL(l2)"/>
        <org.eventb.core.prPred name="p135" org.eventb.core.predicate="¬Blocked=ReadyL"/>
        <org.eventb.core.prPred name="p462" org.eventb.core.predicate="{LAPMO}=PM"/>
