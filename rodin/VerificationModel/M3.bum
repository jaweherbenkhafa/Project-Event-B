    <org.eventb.core.variable name=")~" org.eventb.core.identifier="clearanceT"/>
    <org.eventb.core.invariant name="*'" org.eventb.core.label="inv11" org.eventb.core.predicate="dom(entryTMAOf) ⊆ dom(cpOf)"/>
    <org.eventb.core.invariant name="*(" org.eventb.core.label="inv12" org.eventb.core.predicate=" ∀ a · a ∈ dom(cpTime) ⇒ cpTime(a) ≥ mergeTime(a)"/>
