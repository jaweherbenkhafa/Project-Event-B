        <org.eventb.core.parameter name="2" org.eventb.core.identifier="aircraft"/>
        <org.eventb.core.action name="3" org.eventb.core.assignment="legIndex ≔ {aircraft} ⩤ legIndex" org.eventb.core.label="act4"/>
        <org.eventb.core.action name="4" org.eventb.core.assignment="legPointTime ≔ {aircraft} ⩤ legPointTime" org.eventb.core.label="act5"/>
        <org.eventb.core.guard name="9" org.eventb.core.label="grd12" org.eventb.core.predicate="∀ a · a ∈ dom(mergeTime) ∧ a ∈ dom(legOf) ∧ PmsMerge(legPMS(legOf(a))) = pm&#13;&#10;         ⇒ mergeTime(a) &lt; current_time + tlm"/>
        <org.eventb.core.guard name=":" org.eventb.core.label="grd13" org.eventb.core.predicate=" ∀ a · a ∈ dom(mergeTime) ∧ a ∈ dom(legOf) ∧ a ∈ dom(brandof) ∧ PmsMerge(legPMS(legOf(a))) = pm&#13;&#10;         ⇒ current_time + tlm − mergeTime(a) ≥ Separation_time(brandof(a) ↦ brandof(aircraft))"/>
        <org.eventb.core.guard name=";" org.eventb.core.label="grd14" org.eventb.core.predicate="∀ b · b ∈ dom(legEntryTime) ∧ b ∈ dom(legOf) ∧ legOf(b) = leg ∧ legEntryTime(b) &lt; legEntryTime(aircraft)&#13;&#10;         ⇒ b ∈ dom(mergeTime) ∧ mergeTime(b) &lt; current_time + tlm"/>
        <org.eventb.core.guard name="A" org.eventb.core.label="grd15" org.eventb.core.predicate="∀ a · a ∈ dom(mergeTime ∪ {aircraft ↦ current_time + tlm}) ⇒ a ∈ dom(legOf) ∧ PmsMerge(legPMS(legOf(a))) ∈ dom(lastMergeTime  {pm ↦ current_time + tlm}) ∧ (mergeTime ∪ {aircraft ↦ current_time + tlm})(a) ≤ (lastMergeTime  {pm ↦ current_time + tlm})(PmsMerge(legPMS(legOf(a))))"/>
        <org.eventb.core.guard name="B" org.eventb.core.label="grd16" org.eventb.core.predicate="∀ a · a ∈ dom(mergeTime ∪ {aircraft ↦ current_time + tlm}) ∧ a ∈ dom(brandof) ∧ (mergeTime ∪ {aircraft ↦ current_time + tlm})(a) &lt; (lastMergeTime  {pm ↦ current_time + tlm})(PmsMerge(legPMS(legOf(a)))) ⇒ (lastMergeTime  {pm ↦ current_time + tlm})(PmsMerge(legPMS(legOf(a)))) − (mergeTime ∪ {aircraft ↦ current_time + tlm})(a) ≥ Separation_time(brandof(a) ↦ (lastMergeBrand   {pm ↦ brandof(aircraft)})(PmsMerge(legPMS(legOf(a)))))"/>
        <org.eventb.core.guard name="C" org.eventb.core.label="grd17" org.eventb.core.predicate="∀ a,b · a ∈ dom(mergeTime ∪ {aircraft ↦ current_time + tlm}) ∧ b ∈ dom(mergeTime ∪ {aircraft ↦ current_time + tlm}) ∧ a ≠ b ∧ a ∈ dom(legOf) ∧ b ∈ dom(legOf) ∧ a ∈ dom(brandof) ∧ b ∈ dom(brandof) ∧ PmsMerge(legPMS(legOf(a))) = PmsMerge(legPMS(legOf(b))) ∧ (mergeTime ∪ {aircraft ↦ current_time + tlm})(a) ≤ (mergeTime ∪ {aircraft ↦ current_time + tlm})(b) ⇒ (mergeTime ∪ {aircraft ↦ current_time + tlm})(b) − (mergeTime ∪ {aircraft ↦ current_time + tlm})(a) ≥ Separation_time(brandof(a) ↦ brandof(b))"/>
        <org.eventb.core.guard name="D" org.eventb.core.label="grd18" org.eventb.core.predicate="∀ a,b · a ∈ dom(legEntryTime) ∧ b ∈ dom(legEntryTime) ∧ legOf(a) = legOf(b) ∧ legEntryTime(a) &lt; legEntryTime(b) ∧ b ∈ dom(mergeTime ∪ {aircraft ↦ current_time + tlm}) ⇒ a ∈ dom(mergeTime ∪ {aircraft ↦ current_time + tlm}) ∧ (mergeTime ∪ {aircraft ↦ current_time + tlm})(a) &lt; (mergeTime ∪ {aircraft ↦ current_time + tlm})(b)"/>
        <org.eventb.core.guard name="E" org.eventb.core.label="grd19" org.eventb.core.predicate="dom(legEntryTime) ⊆ dom({aircraft} ⩤ legIndex) ∪ dom(mergeTime ∪ {aircraft ↦ current_time + tlm})"/>
        <org.eventb.core.guard name="(" org.eventb.core.label="grd8" org.eventb.core.predicate="aircraft ∈ dom(cpOf) ∧ f = cpOf(aircraft)"/>
