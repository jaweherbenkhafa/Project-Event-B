    <org.eventb.core.event name=")^" org.eventb.core.convergence="0" org.eventb.core.extended="false" org.eventb.core.label="Entry_in_TMA">
        <org.eventb.core.refinesEvent name="'" org.eventb.core.target="Entry_in_TMA"/>
        <org.eventb.core.parameter name="'" org.eventb.core.identifier="aircraft"/>
        <org.eventb.core.guard name="internal5" org.eventb.core.label="grd1" org.eventb.core.predicate="aircraft ∈ AIRCRAFTS ∧ aircraft ∉ aircrafts_in_TMA"/>
        <org.eventb.core.guard name="internal6" org.eventb.core.label="grd2" org.eventb.core.predicate="aircraft ∉ dom(statusof)"/>
