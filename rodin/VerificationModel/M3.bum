        <org.eventb.core.action name="." org.eventb.core.assignment="mergeTime ≔ mergeTime ∪ {aircraft ↦ (current_time + tlm)}" org.eventb.core.label="act1"/>
        <org.eventb.core.action name="/" org.eventb.core.assignment="lastMergeTime(pm)  ≔ current_time + tlm" org.eventb.core.label="act2"/>
        <org.eventb.core.action name="0" org.eventb.core.assignment="lastMergeBrand(pm) ≔ brandof(aircraft)" org.eventb.core.label="act3"/>
