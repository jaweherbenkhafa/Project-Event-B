    <org.eventb.core.invariant name=")l" org.eventb.core.label="inv2" org.eventb.core.predicate=" ∀ a · a ∈ dom(cpOf)&#13;&#10;         ⇒ a ∈ dom(entryTMAOf)&#13;&#10;           ∧ (PmsMerge(legPMS(TMAToLeg(entryTMAOf(a)))) ↦ cpOf(a)) ∈ pmCP"/>
    <org.eventb.core.invariant name=")m" org.eventb.core.label="inv3" org.eventb.core.predicate="cpTime ∈ aircrafts_in_TMA ⇸ ℕ&#13;&#10;        ∧ dom(cpTime) = dom(mergeTime) ∧ dom(cpTime) ⊆ dom(cpOf)"/>
    <org.eventb.core.invariant name=")q" org.eventb.core.label="inv4" org.eventb.core.predicate="lastcpTime ∈ CP ⇸ ℕ ∧ lastcpBrand ∈ CP ⇸ WTC&#13;&#10;        ∧ dom(lastcpTime) = dom(lastcpBrand)"/>
    <org.eventb.core.invariant name=")n" org.eventb.core.label="inv5" org.eventb.core.predicate="∀ a · a ∈ dom(cpOf) ⇒ CPRunway(cpOf(a)) ∈ activeRunways"/>
    <org.eventb.core.invariant name=")o" org.eventb.core.label="inv6" org.eventb.core.predicate=" ∀ a · a ∈ dom(cpTime)&#13;&#10;          ⇒ cpOf(a) ∈ dom(lastcpTime) ∧ cpTime(a) ≤ lastcpTime(cpOf(a))"/>
    <org.eventb.core.invariant name=")p" org.eventb.core.label="inv7" org.eventb.core.predicate=" ∀ a · a ∈ dom(cpTime) ∧ a ∈ dom(brandof)&#13;&#10;          ∧ cpTime(a) = lastcpTime(cpOf(a))&#13;&#10;        ⇒ brandof(a) = lastcpBrand(cpOf(a))"/>
    <org.eventb.core.invariant name=")r" org.eventb.core.label="inv8" org.eventb.core.predicate="∀ a · a ∈ dom(cpTime) ∧ a ∈ dom(brandof)&#13;&#10;          ∧ cpTime(a) &lt; lastcpTime(cpOf(a))&#13;&#10;        ⇒ lastcpTime(cpOf(a)) − cpTime(a)&#13;&#10;            ≥ Separation_time(brandof(a) ↦ lastcpBrand(cpOf(a)))"/>
    <org.eventb.core.invariant name=")s" org.eventb.core.label="inv9" org.eventb.core.predicate="∀ a,b · a ∈ dom(cpTime) ∧ b ∈ dom(cpTime) ∧ a ≠ b&#13;&#10;          ∧ a ∈ dom(brandof) ∧ b ∈ dom(brandof)&#13;&#10;          ∧ cpOf(a) = cpOf(b) ∧ cpTime(a) ≤ cpTime(b)&#13;&#10;        ⇒ cpTime(b) − cpTime(a) ≥ Separation_time(brandof(a) ↦ brandof(b))"/>
    <org.eventb.core.invariant name=")t" org.eventb.core.label="inv10" org.eventb.core.predicate="∀ a · a ∈ dom(plannedRunway)&#13;&#10;          ⇒ a ∈ dom(cpOf) ∧ plannedRunway(a) = CPRunway(cpOf(a))"/>
    <org.eventb.core.seesContext name=")v" org.eventb.core.target="C2"/>
