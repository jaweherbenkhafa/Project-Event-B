        <org.eventb.core.action name="6" org.eventb.core.assignment="brandof≔ brandof ∪ {aircraft ↦ brand}" org.eventb.core.label="act4"/>
        <org.eventb.core.guard name="F" org.eventb.core.label="grd24" org.eventb.core.predicate="entrytma ∈ ENTRYTMA"/>
        <org.eventb.core.guard name="internalN" org.eventb.core.label="grd25" org.eventb.core.predicate="aircraft ∉ dom(ETA) ∧ aircraft ∉ dom(tmaEntryTime) ∧ aircraft ∉ dom(entryTMAOf)"/>
        <org.eventb.core.parameter name="G" org.eventb.core.identifier="duration_entry_merge"/>
        <org.eventb.core.action name="K" org.eventb.core.assignment="ETA≔ ETA ∪  {aircraft ↦ (previous + current_time + duration_entry_merge)}" org.eventb.core.label="act5"/>
        <org.eventb.core.guard name="internal;" org.eventb.core.label="grd9" org.eventb.core.predicate="duration_entry_merge = (routeDist(entrytma) ∗ 360) ÷ SpeedbeforeLeg"/>
        <org.eventb.core.guard name="internalD" org.eventb.core.label="grd10" org.eventb.core.predicate="entrytma ∈ dom(lastEntryTime) ∧ current_time ≥ lastEntryTime(entrytma) + Separation_time(lastEntryBrand(entrytma) ↦ brand) ⇒ previous = 0"/>
        <org.eventb.core.guard name="internal11" org.eventb.core.label="grd11" org.eventb.core.predicate="entrytma ∈ dom(lastEntryTime) ∧ current_time &lt; lastEntryTime(entrytma) + Separation_time(lastEntryBrand(entrytma) ↦ brand) ⇒ previous = lastEntryTime(entrytma) + Separation_time(lastEntryBrand(entrytma) ↦ brand) − current_time"/>
        <org.eventb.core.action name="internalF" org.eventb.core.assignment="lastEntryTime(entrytma)  ≔ current_time + previous" org.eventb.core.label="act6"/>
        <org.eventb.core.parameter name="internalH" org.eventb.core.identifier="previous"/>
        <org.eventb.core.action name="internalJ" org.eventb.core.assignment="lastEntryBrand(entrytma) ≔ brand" org.eventb.core.label="act7"/>
        <org.eventb.core.action name="internalM" org.eventb.core.assignment="tmaEntryTime ≔ tmaEntryTime ∪ {aircraft ↦ (current_time + previous)}" org.eventb.core.label="act8"/>
        <org.eventb.core.guard name="internalO" org.eventb.core.label="grd12" org.eventb.core.predicate="previous + current_time + duration_entry_merge∈ ℕ"/>
        <org.eventb.core.guard name="internal12" org.eventb.core.label="grd13" org.eventb.core.predicate="entrytma ∈ dom(lastEntryTime) ⇒ current_time + previous ≥ lastEntryTime(entrytma) + Separation_time(lastEntryBrand(entrytma) ↦ brand)&#13;&#10;"/>
        <org.eventb.core.guard name="internal13" org.eventb.core.label="grd14" org.eventb.core.predicate="entrytma ∈ dom(lastEntryTime) ⇒ current_time + previous &gt; lastEntryTime(entrytma)"/>
        <org.eventb.core.guard name="internalS" org.eventb.core.label="grd15" org.eventb.core.predicate="aircraft ∉ dom(legOf) ∧ aircraft ∉ dom(legIndex) ∧ aircraft ∉ dom(legEntryTime) ∧ aircraft ∉ dom(mergeTime) ∧ aircraft ∉ dom(acLevel) ∧ aircraft ∉ dom(plannedRunway) ∧ aircraft ∉ dom(Threshold)"/>
        <org.eventb.core.guard name="internalT" org.eventb.core.label="grd16" org.eventb.core.predicate="entrytma ∉ dom(lastEntryTime) ⇒ previous = 0"/>
        <org.eventb.core.guard name="internalU" org.eventb.core.label="grd17" org.eventb.core.predicate="∀ a · a ∈ dom(tmaEntryTime) ∧ a ∈ dom(entryTMAOf) ∧ a ∈ dom(brandof) ∧ entryTMAOf(a) = entrytma&#13;&#10;         ⇒ current_time + previous &gt; tmaEntryTime(a)&#13;&#10;           ∧ current_time + previous − tmaEntryTime(a) ≥ Separation_time(brandof(a) ↦ brand)"/>
        <org.eventb.core.guard name="internalV" org.eventb.core.label="grd18" org.eventb.core.predicate="∀ a · a ∈ dom(tmaEntryTime) ∧ a ∈ dom(entryTMAOf) ∧ entryTMAOf(a) = entrytma&#13;&#10;         ⇒ tmaEntryTime(a) &lt; current_time + previous"/>
        <org.eventb.core.guard name="internalW" org.eventb.core.label="grd19" org.eventb.core.predicate="ETA ∪ {aircraft ↦ (previous + current_time + duration_entry_merge)} ∈ aircrafts_in_TMA ∪ {aircraft} ⇸ ℕ"/>
        <org.eventb.core.guard name="internalX" org.eventb.core.label="grd20" org.eventb.core.predicate="lastEntryTime  {entrytma ↦ current_time + previous} ∈ ENTRYTMA ⇸ ℕ ∧ lastEntryBrand  {entrytma ↦ brand} ∈ ENTRYTMA ⇸ WTC ∧ dom(lastEntryTime  {entrytma ↦ current_time + previous}) = dom(lastEntryBrand   {entrytma ↦ brand})"/>
        <org.eventb.core.guard name="internalY" org.eventb.core.label="grd21" org.eventb.core.predicate="∀ a,b · a ∈ dom(legEntryTime) ∧ b ∈ dom(legEntryTime) ∧ a ≠ b ∧ a ∈ dom(brandof ∪ {aircraft ↦ brand}) ∧ b ∈ dom(brandof ∪ {aircraft ↦ brand}) ∧ legOf(a) = legOf(b) ∧ legEntryTime(a) ≤ legEntryTime(b) ⇒ (legEntryTime(b) − legEntryTime(a)) ∗ legSpeed ≥ Separation_dist((brandof ∪ {aircraft ↦ brand})(a) ↦ (brandof ∪ {aircraft ↦ brand})(b)) ∗ 360"/>
        <org.eventb.core.guard name="internalZ" org.eventb.core.label="grd22" org.eventb.core.predicate="∀ a · a ∈ dom(tmaEntryTime ∪ {aircraft ↦ current_time + previous}) ⇒ a ∈ dom(entryTMAOf ∪ {aircraft ↦ entrytma}) ∧ (entryTMAOf ∪ {aircraft ↦ entrytma})(a) ∈ dom(lastEntryTime  {entrytma ↦ current_time + previous}) ∧ (tmaEntryTime ∪ {aircraft ↦ current_time + previous})(a) ≤ (lastEntryTime  {entrytma ↦ current_time + previous})((entryTMAOf ∪ {aircraft ↦ entrytma})(a))"/>
