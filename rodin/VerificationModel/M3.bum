        <org.eventb.core.guard name="internalP" org.eventb.core.label="grd6" org.eventb.core.predicate="pm = PmsMerge(legPMS(TMAToLeg(entrytma)))"/>
        <org.eventb.core.guard name="internalQ" org.eventb.core.label="grd7" org.eventb.core.predicate="(pm ↦ f) ∈ pmCP"/>
        <org.eventb.core.guard name="internalR" org.eventb.core.label="grd8" org.eventb.core.predicate="CPRunway(f) ∈ activeRunways"/>
        <org.eventb.core.action name="internalS" org.eventb.core.assignment="cpOf ≔ cpOf ∪ {aircraft ↦ f}" org.eventb.core.label="act9"/>
