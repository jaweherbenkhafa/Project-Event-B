        <org.eventb.core.parameter name="(" org.eventb.core.identifier="entrytma"/>
        <org.eventb.core.action name="internal?" org.eventb.core.assignment="entryTMAOf ≔ entryTMAOf ∪ {aircraft ↦ entrytma}" org.eventb.core.label="act3"/>
