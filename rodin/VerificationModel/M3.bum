        <org.eventb.core.guard name="&gt;" org.eventb.core.label="grd20" org.eventb.core.predicate="current_time + wpDistMerge(legSeq(legOf(aircraft))(legIndex(aircraft))) ∗ 360 ÷ legSpeed ∈ ℕ"/>
        <org.eventb.core.guard name="8" org.eventb.core.label="grd21" org.eventb.core.predicate="tlm ∈ ℕ ∧ pm ∈ PM ∧ brandof(aircraft) ∈ WTC"/>
        <org.eventb.core.guard name="=" org.eventb.core.label="grd22" org.eventb.core.predicate="pm ∈ dom(lastMergeTime) ⇒ pm ∈ dom(lastMergeBrand) ∧ lastMergeBrand(pm) ∈ WTC"/>
        <org.eventb.core.guard name="internal9" org.eventb.core.label="grd6" org.eventb.core.predicate=" ∀ b · b ∈ dom(legIndex) ∧ b ∈ dom(legOf) ∧ b ∈ dom(legEntryTime) ∧ legOf(b) = leg&#13;&#10;             ⇒ legEntryTime(b)≥ legEntryTime(aircraft)"/>
        <org.eventb.core.guard name="@" org.eventb.core.label="grd23" org.eventb.core.predicate="PmsMerge(legPMS(legOf(aircraft))) ∈ dom(lastMergeTime)&#13;&#10;         ⇒ PmsMerge(legPMS(legOf(aircraft))) ∈ dom(lastMergeBrand)&#13;&#10;           ∧ (lastMergeBrand(PmsMerge(legPMS(legOf(aircraft)))) ↦ brandof(aircraft)) ∈ dom(Separation_time)"/>
