        <org.eventb.core.guard name="internalP" org.eventb.core.label="grd11" org.eventb.core.predicate="entrytma ∈ dom(lastEntryTime) ∧ current_time &lt; lastEntryTime(entrytma) + Separation_time(lastEntryBrand(entrytma) ↦ brand) ⇒ previous = lastEntryTime(entrytma) + Separation_time(lastEntryBrand(entrytma) ↦ brand) − current_time"/>
        <org.eventb.core.action name="internalF" org.eventb.core.assignment="lastEntryTime(entrytma)  ≔ current_time + previous" org.eventb.core.label="act6"/>
