    <org.eventb.core.invariant name=")|" org.eventb.core.label="inv32" org.eventb.core.predicate=" ∀ a · a ∈ dom(tmaEntryTime) ⇒ a ∈ dom(entryTMAOf) ∧ entryTMAOf(a) ∈ dom(lastEntryTime) ∧ tmaEntryTime(a) ≤ lastEntryTime(entryTMAOf(a))&#13;&#10;"/>
    <org.eventb.core.invariant name=")}" org.eventb.core.label="inv33" org.eventb.core.predicate="∀ a · a ∈ dom(tmaEntryTime) ∧ a ∈ dom(brandof) ∧ tmaEntryTime(a) = lastEntryTime(entryTMAOf(a)) ⇒ brandof(a) = lastEntryBrand(entryTMAOf(a))&#13;&#10;"/>
    <org.eventb.core.invariant name=")~" org.eventb.core.label="inv7" org.eventb.core.predicate="∀ a · a ∈ dom(tmaEntryTime) ∧ a ∈ dom(brandof) ∧ tmaEntryTime(a) &lt; lastEntryTime(entryTMAOf(a)) ⇒ lastEntryTime(entryTMAOf(a)) − tmaEntryTime(a) ≥ Separation_time(brandof(a) ↦ lastEntryBrand(entryTMAOf(a)))"/>
    <org.eventb.core.invariant name="*'" org.eventb.core.label="inv17" org.eventb.core.predicate="∀ a · a ∈ dom(legIndex) ⇒ a ∈ dom(acLevel) ∧ acLevel(a) = legFL(legOf(a))&#13;&#10;"/>
    <org.eventb.core.invariant name="*+" org.eventb.core.label="inv35" org.eventb.core.predicate="∀ a,b · a ∈ dom(legIndex) ∧ a ∈ dom(legOf) ∧ a ∈ dom(acLevel)&#13;&#10;                ∧ b ∈ dom(legIndex) ∧ b ∈ dom(legOf) ∧ b ∈ dom(acLevel)&#13;&#10;                ∧ legOf(a) = legOf(b)&#13;&#10;         ⇒ acLevel(a) = acLevel(b)" org.eventb.core.theorem="true"/>
    <org.eventb.core.invariant name="*(" org.eventb.core.label="inv18" org.eventb.core.predicate="∀ a,b · a ∈ dom(legIndex) ∧ b ∈ dom(legIndex) ∧ legOf(a) ≠ legOf(b) ∧ legPMS(legOf(a)) = legPMS(legOf(b)) ⇒ acLevel(a) ≥ acLevel(b) + VSep ∨ acLevel(b) ≥ acLevel(a) + VSep"/>
    <org.eventb.core.invariant name="*)" org.eventb.core.label="inv36" org.eventb.core.predicate="∀ a · a ∈ dom(clearanceL) ⇒ a ∈ dom(Threshold)"/>
    <org.eventb.core.invariant name="**" org.eventb.core.label="inv37" org.eventb.core.predicate="∀ a · a ∈ aircrafts_in_TMA ∧ statusof(a) ∈ {ScheduledL, ReadyL} ⇒ a ∈ dom(plannedRunway)"/>
    <org.eventb.core.invariant name="*," org.eventb.core.label="inv38" org.eventb.core.predicate="dom(legEntryTime) ⊆ dom(legIndex) ∪ dom(mergeTime)"/>
</org.eventb.core.machineFile>
