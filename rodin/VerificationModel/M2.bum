        <org.eventb.core.guard name="internalR" org.eventb.core.label="grd14" org.eventb.core.predicate="entrytma ∈ dom(lastEntryTime) ⇒ current_time + previous &gt; lastEntryTime(entrytma)"/>
        <org.eventb.core.guard name="internalS" org.eventb.core.label="grd15" org.eventb.core.predicate="aircraft ∉ dom(legOf) ∧ aircraft ∉ dom(legIndex) ∧ aircraft ∉ dom(legEntryTime) ∧ aircraft ∉ dom(mergeTime) ∧ aircraft ∉ dom(acLevel) ∧ aircraft ∉ dom(plannedRunway) ∧ aircraft ∉ dom(Threshold)"/>
