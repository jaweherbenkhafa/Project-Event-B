        <org.eventb.core.guard name="F" org.eventb.core.label="grd12" org.eventb.core.predicate="∀ b · b ∈ dom(legEntryTime) ∧ b ∈ dom(legOf) ∧ b ∈ dom(brandof) ∧ legOf(b) = leg&#13;&#10;         ⇒ previous &gt; legEntryTime(b)&#13;&#10;           ∧ previous − legEntryTime(b) ≥ Separation_time(brandof(b) ↦ brandof(aircraft))&#13;&#10;           ∧ (previous − legEntryTime(b)) ∗ legSpeed ≥ Separation_dist(brandof(b) ↦ brandof(aircraft)) ∗ 360"/>
