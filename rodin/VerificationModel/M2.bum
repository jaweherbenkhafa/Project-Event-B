        <org.eventb.core.guard name="K" org.eventb.core.label="grd17" org.eventb.core.predicate="∀ a,b · a ∈ dom(legEntryTime ∪ {aircraft ↦ previous}) ∧ b ∈ dom(legEntryTime ∪ {aircraft ↦ previous}) ∧ a ≠ b ∧ a ∈ dom(brandof) ∧ b ∈ dom(brandof) ∧ (legOf ∪ {aircraft ↦ leg})(a) = (legOf ∪ {aircraft ↦ leg})(b) ∧ (legEntryTime ∪ {aircraft ↦ previous})(a) ≤ (legEntryTime ∪ {aircraft ↦ previous})(b) ⇒ ((legEntryTime ∪ {aircraft ↦ previous})(b) − (legEntryTime ∪ {aircraft ↦ previous})(a)) ∗ legSpeed ≥ Separation_dist(brandof(a) ↦ brandof(b)) ∗ 360"/>
        <org.eventb.core.guard name="L" org.eventb.core.label="grd18" org.eventb.core.predicate=" legEntryTime ∪ {aircraft ↦ previous} ∈ aircrafts_in_TMA ⇸ ℕ&#13;&#10;       ∧ legOf ∪ {aircraft ↦ leg} ∈ aircrafts_in_TMA ⇸ SLEGS&#13;&#10;       ∧ acLevel ∪ {aircraft ↦ legFL(leg)} ∈ aircrafts_in_TMA ⇸ ℕ1&#13;&#10;       ∧ legIndex ∪ {aircraft ↦ 1} ∈ aircrafts_in_TMA ⇸ ℕ1&#13;&#10;       ∧ dom(legEntryTime ∪ {aircraft ↦ previous}) ⊆ dom(legOf ∪ {aircraft ↦ leg})&#13;&#10;       ∧ dom(legIndex ∪ {aircraft ↦ 1}) ⊆ dom(legOf ∪ {aircraft ↦ leg})"/>
        <org.eventb.core.guard name="M" org.eventb.core.label="grd19" org.eventb.core.predicate="∀ a · a ∈ dom(legIndex ∪ {aircraft ↦ 1})&#13;&#10;         ⇒ a ∈ dom(legOf ∪ {aircraft ↦ leg})&#13;&#10;         ∧ a ∈ dom(acLevel ∪ {aircraft ↦ legFL(leg)})&#13;&#10;         ∧ (acLevel ∪ {aircraft ↦ legFL(leg)})(a) = legFL((legOf ∪ {aircraft ↦ leg})(a))"/>
        <org.eventb.core.guard name="N" org.eventb.core.label="grd20" org.eventb.core.predicate="∀ a,b · a ∈ dom(legEntryTime ∪ {aircraft ↦ previous})&#13;&#10;         ∧ b ∈ dom(legEntryTime ∪ {aircraft ↦ previous})&#13;&#10;         ∧ (legOf ∪ {aircraft ↦ leg})(a) = (legOf ∪ {aircraft ↦ leg})(b)&#13;&#10;         ∧ (legEntryTime ∪ {aircraft ↦ previous})(a) &lt; (legEntryTime ∪ {aircraft ↦ previous})(b)&#13;&#10;         ∧ b ∈ dom(mergeTime)&#13;&#10;         ⇒ a ∈ dom(mergeTime) ∧ mergeTime(a) &lt; mergeTime(b)"/>
    </org.eventb.core.event>
