        <org.eventb.core.guard name="internalX" org.eventb.core.label="grd20" org.eventb.core.predicate="lastEntryTime  {entrytma ↦ current_time + previous} ∈ ENTRYTMA ⇸ ℕ ∧ lastEntryBrand  {entrytma ↦ brand} ∈ ENTRYTMA ⇸ WTC ∧ dom(lastEntryTime  {entrytma ↦ current_time + previous}) = dom(lastEntryBrand   {entrytma ↦ brand})"/>
        <org.eventb.core.guard name="internalY" org.eventb.core.label="grd21" org.eventb.core.predicate="∀ a,b · a ∈ dom(legEntryTime) ∧ b ∈ dom(legEntryTime) ∧ a ≠ b ∧ a ∈ dom(brandof ∪ {aircraft ↦ brand}) ∧ b ∈ dom(brandof ∪ {aircraft ↦ brand}) ∧ legOf(a) = legOf(b) ∧ legEntryTime(a) ≤ legEntryTime(b) ⇒ (legEntryTime(b) − legEntryTime(a)) ∗ legSpeed ≥ Separation_dist((brandof ∪ {aircraft ↦ brand})(a) ↦ (brandof ∪ {aircraft ↦ brand})(b)) ∗ 360"/>
        <org.eventb.core.guard name="internalZ" org.eventb.core.label="grd22" org.eventb.core.predicate="∀ a · a ∈ dom(tmaEntryTime ∪ {aircraft ↦ current_time + previous}) ⇒ a ∈ dom(entryTMAOf ∪ {aircraft ↦ entrytma}) ∧ (entryTMAOf ∪ {aircraft ↦ entrytma})(a) ∈ dom(lastEntryTime  {entrytma ↦ current_time + previous}) ∧ (tmaEntryTime ∪ {aircraft ↦ current_time + previous})(a) ≤ (lastEntryTime  {entrytma ↦ current_time + previous})((entryTMAOf ∪ {aircraft ↦ entrytma})(a))"/>
