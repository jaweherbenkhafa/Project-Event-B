    <org.eventb.core.axiom name="){" org.eventb.core.label="axm13" org.eventb.core.predicate=" ∀ l1,l2,w1,w2 · l1 ∈ SLEGS ∧ l2 ∈ SLEGS ∧ l1 ≠ l2 ∧ legPMS(l1) = legPMS(l2)&#13;&#10;           ∧ w1 ∈ WAYPOINT ∧ w2 ∈ WAYPOINT ∧ w1 ∈ ran(legSeq(l1)) ∧ w2 ∈ ran(legSeq(l2))&#13;&#10;           ∧ wpDistMerge(w1) &lt; wpDistMerge(w2)&#13;&#10;         ⇒ legFL(l1) &gt; legFL(l2)"/>
