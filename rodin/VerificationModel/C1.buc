    <org.eventb.core.axiom name="*?" org.eventb.core.label="axm10" org.eventb.core.predicate="wpDistMerge ∈ WAYPOINT → ℕ1 ∧&#13;&#10;        (∀ l,w,x,y,z,mx,my,mz,dx,dy · l ∈ SLEGS ∧ w ∈ WAYPOINT ∧ w ∈ ran(legSeq(l))&#13;&#10;           ∧ (w ↦ ((x ↦ y) ↦ z)) ∈ wppos ∧ (PmsMerge(legPMS(l)) ↦ ((mx ↦ my) ↦ mz)) ∈ pmpos&#13;&#10;           ∧ dx = x − mx ∧ dy = y − my&#13;&#10;         ⇒ wpDistMerge(w) ∗ wpDistMerge(w) ≤ dx∗dx + dy∗dy&#13;&#10;           ∧ dx∗dx + dy∗dy &lt; (wpDistMerge(w) + 1) ∗ (wpDistMerge(w) + 1))"/>
