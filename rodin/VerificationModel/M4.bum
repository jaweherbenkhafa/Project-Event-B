        <org.eventb.core.guard name="*" org.eventb.core.label="grd18" org.eventb.core.predicate="clearanceL ∪ {aircraft ↦ runway} ∈ aircrafts_in_TMA ⇸ RUNWAY ∧ Threshold  {aircraft ↦ landing_instant} ∈ aircrafts_in_TMA ⇸ ℕ"/>
        <org.eventb.core.guard name=")" org.eventb.core.label="grd17" org.eventb.core.predicate="∀ a,d · a ∈ dom(Threshold  {aircraft ↦ landing_instant}) ∧ a ∈ dom(clearanceL ∪ {aircraft ↦ runway}) ∧ d ∈ dom(depTime) ∧ (clearanceL ∪ {aircraft ↦ runway})(a) = depRwy(d)&#13;&#10;⇒ (Threshold  {aircraft ↦ landing_instant})(a) ≥ depTime(d) + RwySep ∨ depTime(d) ≥ (Threshold  {aircraft ↦ landing_instant})(a) + RwySep"/>
    </org.eventb.core.event>
