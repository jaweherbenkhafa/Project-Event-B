    <org.eventb.core.event name="*(" org.eventb.core.convergence="0" org.eventb.core.extended="false" org.eventb.core.label="Schedule_Arrival">
        <org.eventb.core.refinesEvent name="'" org.eventb.core.target="Schedule_Arrival"/>
