    <org.eventb.core.event name="*0" org.eventb.core.convergence="0" org.eventb.core.extended="false" org.eventb.core.label="Start_takingoff">
        <org.eventb.core.refinesEvent name="'" org.eventb.core.target="Start_takingoff"/>
        <org.eventb.core.parameter name="'" org.eventb.core.identifier="aircraft"/>
        <org.eventb.core.parameter name="(" org.eventb.core.identifier="runway"/>
        <org.eventb.core.guard name="internal1" org.eventb.core.label="grd1" org.eventb.core.predicate="aircraft ∈ aircrafts_in_TMA ∧ statusof(aircraft) = ExecutedT"/>
        <org.eventb.core.guard name="internal2" org.eventb.core.label="grd2" org.eventb.core.predicate="runway ∈ RUNWAY ∧ curr_RW_status(runway) = Available ∧ curr_RWL_status(runway) = OFF"/>
        <org.eventb.core.action name="+" org.eventb.core.assignment="statusof(aircraft) ≔ Takingoff" org.eventb.core.label="act1"/>
        <org.eventb.core.action name="," org.eventb.core.assignment="curr_RW_status(runway) ≔ Unavailable" org.eventb.core.label="act2"/>
        <org.eventb.core.action name="internal1" org.eventb.core.assignment="curr_RWL_status(runway) ≔ ON" org.eventb.core.label="act3"/>
        <org.eventb.core.guard name="internal3" org.eventb.core.label="grd3" org.eventb.core.predicate="aircraft ∈ dom(clearanceT) ∧ runway = clearanceT(aircraft)"/>
        <org.eventb.core.guard name="," org.eventb.core.label="grd8" org.eventb.core.predicate="aircraft ∈ dom(brandof) ∧ aircraft ∈ dom(readyTime)"/>
        <org.eventb.core.action name="-" org.eventb.core.assignment="depTime(aircraft) ≔ current_time" org.eventb.core.label="act5"/>
        <org.eventb.core.action name="." org.eventb.core.assignment="depRwy(aircraft) ≔ runway" org.eventb.core.label="act6"/>
        <org.eventb.core.action name="/" org.eventb.core.assignment="lastDepTime(runway) ≔ current_time" org.eventb.core.label="act7"/>
        <org.eventb.core.action name="0" org.eventb.core.assignment="lastDepBrand(runway) ≔ brandof(aircraft)" org.eventb.core.label="act8"/>
        <org.eventb.core.action name="1" org.eventb.core.assignment="readyTime ≔ {aircraft} ⩤ readyTime" org.eventb.core.label="act9"/>
        <org.eventb.core.guard name="(" org.eventb.core.label="grd4" org.eventb.core.predicate="∀ b · b ∈ aircrafts_in_TMA ∧ statusof(b) = ExecutedT ∧ b ∈ dom(readyTime)&#13;&#10;           ∧ b ∈ dom(clearanceT) ∧ clearanceT(b) = runway&#13;&#10;         ⇒ readyTime(b) ≥ readyTime(aircraft)"/>
        <org.eventb.core.guard name="internal4" org.eventb.core.label="grd9" org.eventb.core.predicate="brandof(aircraft) ∈ WTC ∧ aircraft ∉ dom(depTime) ∧ (runway ∈ dom(lastDepTime) ⇒ runway ∈ dom(lastDepBrand))"/>
        <org.eventb.core.guard name=")" org.eventb.core.label="grd5" org.eventb.core.predicate=" runway ∉ dom(lastDepTime)&#13;&#10;         ∨ current_time ≥ lastDepTime(runway)&#13;&#10;               + DepDepSep(lastDepBrand(runway) ↦ brandof(aircraft))"/>
        <org.eventb.core.guard name="*" org.eventb.core.label="grd6" org.eventb.core.predicate="runway ∉ dom(lastTouchdown) ∨ current_time ≥ lastTouchdown(runway) + RwySep"/>
        <org.eventb.core.guard name="+" org.eventb.core.label="grd7" org.eventb.core.predicate="∀ a · a ∈ dom(Threshold) ∧ a ∈ dom(clearanceL) ∧ clearanceL(a) = runway&#13;&#10;           ⇒ Threshold(a) ≥ current_time + RwySep ∨ current_time ≥ Threshold(a) + RwySep"/>
        <org.eventb.core.guard name="internal5" org.eventb.core.label="grd10" org.eventb.core.predicate="∀ d · d ∈ dom(depTime) ∧ d ∈ dom(brandof) ∧ depRwy(d) = runway ⇒ current_time ≥ depTime(d) + DepDepSep(brandof(d) ↦ brandof(aircraft))"/>
        <org.eventb.core.guard name="internal6" org.eventb.core.label="grd11" org.eventb.core.predicate="depTime  {aircraft ↦ current_time} ∈ aircrafts_in_TMA ⇸ ℕ ∧ depRwy  {aircraft ↦ runway} ∈ aircrafts_in_TMA ⇸ RUNWAY ∧ dom(depRwy  {aircraft ↦ runway}) = dom(depTime  {aircraft ↦ current_time}) ∧ lastDepTime  {runway ↦ current_time} ∈ RUNWAY ⇸ ℕ ∧ lastDepBrand  {runway ↦ brandof(aircraft)} ∈ RUNWAY ⇸ WTC ∧ dom(lastDepTime  {runway ↦ current_time}) = dom(lastDepBrand  {runway ↦ brandof(aircraft)})"/>
        <org.eventb.core.guard name="internal7" org.eventb.core.label="grd12" org.eventb.core.predicate="∀ a · a ∈ dom(depTime  {aircraft ↦ current_time}) ⇒ (depRwy  {aircraft ↦ runway})(a) ∈ dom(lastDepTime  {runway ↦ current_time}) ∧ (lastDepBrand  {runway ↦ brandof(aircraft)})((depRwy  {aircraft ↦ runway})(a)) ∈ WTC"/>
        <org.eventb.core.guard name="internal8" org.eventb.core.label="grd13" org.eventb.core.predicate="∀ a · a ∈ dom(depTime  {aircraft ↦ current_time}) ∧ a ∈ dom(brandof) ∧ (depTime  {aircraft ↦ current_time})(a) &lt; (lastDepTime  {runway ↦ current_time})((depRwy  {aircraft ↦ runway})(a)) ⇒ (lastDepTime  {runway ↦ current_time})((depRwy  {aircraft ↦ runway})(a)) − (depTime  {aircraft ↦ current_time})(a) ≥ DepDepSep(brandof(a) ↦ (lastDepBrand  {runway ↦ brandof(aircraft)})((depRwy  {aircraft ↦ runway})(a)))"/>
    </org.eventb.core.event>
    <org.eventb.core.event name="*1" org.eventb.core.convergence="0" org.eventb.core.extended="false" org.eventb.core.label="Terminating_takingoff">
