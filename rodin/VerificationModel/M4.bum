        <org.eventb.core.guard name="internal5" org.eventb.core.label="grd1" org.eventb.core.predicate="aircraft ∈ aircrafts_in_TMA ∧ statusof(aircraft) = Blocked"/>
        <org.eventb.core.guard name="internal4" org.eventb.core.label="grd2" org.eventb.core.predicate="aircraft ∈ dom(mergeTime) ∧ aircraft ∈ dom(legOf) ∧ aircraft ∉ dom(plannedRunway)"/>
        <org.eventb.core.guard name="internalO" org.eventb.core.label="grd3" org.eventb.core.predicate="pm = PmsMerge(legPMS(legOf(aircraft)))"/>
