        <org.eventb.core.action name="internalS" org.eventb.core.assignment="plannedRunway ≔ plannedRunway ∪ {aircraft ↦ runway}" org.eventb.core.label="act3"/>
        <org.eventb.core.parameter name="internalT" org.eventb.core.identifier="runway"/>
        <org.eventb.core.guard name="internalU" org.eventb.core.label="grd8" org.eventb.core.predicate="landingQueue  {runway ↦ landingQueue(runway) ∪ {seqSize(landingQueue(runway)) + 1 ↦ aircraft}} ∈ RUNWAY → seq(AIRCRAFTS)"/>
        <org.eventb.core.guard name="(" org.eventb.core.label="grd6" org.eventb.core.predicate="aircraft ∈ dom(cpOf) ∧ runway = CPRunway(cpOf(aircraft))"/>
        <org.eventb.core.guard name=")" org.eventb.core.label="grd7" org.eventb.core.predicate="∀ b · b ∈ dom(cpTime) ∧ b ≠ aircraft&#13;&#10;           ∧ CPRunway(cpOf(b)) = runway ∧ cpTime(b) &lt; cpTime(aircraft)&#13;&#10;         ⇒ b ∈ dom(plannedRunway)"/>
