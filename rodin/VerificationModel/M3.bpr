        <org.eventb.core.prPred name="p2" org.eventb.core.predicate="∀x⦂WTC,y⦂WTC,z⦂WTC·x∈WTC∧y∈WTC∧z∈WTC⇒Separation_time(x ↦ z)≤Separation_time(x ↦ y)+Separation_time(y ↦ z)"/>
