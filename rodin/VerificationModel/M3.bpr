        <org.eventb.core.prPred name="p264" org.eventb.core.predicate="∀a⦂AIRCRAFTS,b⦂AIRCRAFTS·a∈dom(cpTime)∧b∈dom(cpTime)∧¬a=b∧a∈dom(brandof)∧b∈dom(brandof)∧cpOf(a)=cpOf(b)∧cpTime(a)≤cpTime(b)⇒cpTime(b) − cpTime(a)≥Separation_time(brandof(a) ↦ brandof(b))"/>
        <org.eventb.core.prPred name="p367" org.eventb.core.predicate="∀a⦂AIRCRAFTS·a∈dom(mergeTime)∧a∈dom(legOf)∧a∈dom(brandof)∧PmsMerge(legPMS(legOf(a)))=pm⇒current_time+wpDistMerge(legSeq(legOf(aircraft))(legIndex(aircraft)))∗360 ÷ legSpeed − mergeTime(a)≥Separation_time(brandof(a) ↦ brandof(aircraft))"/>
        <org.eventb.core.prPred name="p155" org.eventb.core.predicate="¬ScheduledL=ExecutedL"/>
        <org.eventb.core.prPred name="p9" org.eventb.core.predicate="clearanceT∈aircrafts_in_TMA ⇸ RUNWAY"/>
        <org.eventb.core.prPred name="p10" org.eventb.core.predicate="∀a⦂AIRCRAFTS·a∈dom(mergeTime)∧a∈dom(brandof)∧mergeTime(a)=lastMergeTime(PmsMerge(legPMS(legOf(a))))⇒brandof(a)=lastMergeBrand(PmsMerge(legPMS(legOf(a))))"/>
        <org.eventb.core.prPred name="p12" org.eventb.core.predicate="∀b⦂AIRCRAFTS·b∈dom(legIndex)∧b∈dom(legOf)∧b∈dom(legEntryTime)∧legOf(b)=leg⇒legEntryTime(b)≥legEntryTime(aircraft)"/>
        <org.eventb.core.prPred name="p13" org.eventb.core.predicate="∀l1⦂SLEGS,l2⦂SLEGS,w1⦂WAYPOINT,w2⦂WAYPOINT·l1∈SLEGS∧l2∈SLEGS∧l1≠l2∧legPMS(l1)=legPMS(l2)∧w1∈WAYPOINT∧w2∈WAYPOINT∧w1∈ran(legSeq(l1))∧w2∈ran(legSeq(l2))∧wpDistMerge(w1)&lt;wpDistMerge(w2)⇒legFL(l1)&gt;legFL(l2)"/>
        <org.eventb.core.prPred name="p342" org.eventb.core.predicate="∀l⦂SLEGS,w⦂WAYPOINT,p⦂ℤ×ℤ,z⦂ℤ·w∈ran(legSeq(l))∧w ↦ (p ↦ z)∈wppos⇒z=legFL(l)"/>
        <org.eventb.core.prPred name="p306" org.eventb.core.predicate="cpOf∈AIRCRAFTS ⇸ CP"/>
        <org.eventb.core.prPred name="p146" org.eventb.core.predicate="¬Blocked=ReadyL"/>
        <org.eventb.core.prPred name="p352" org.eventb.core.predicate="∀a⦂AIRCRAFTS·a∈dom(mergeTime)∧a∈dom(legOf)∧PmsMerge(legPMS(legOf(a)))=pm⇒mergeTime(a)&lt;current_time+wpDistMerge(legSeq(leg)(legIndex(aircraft)))∗360 ÷ legSpeed"/>
        <org.eventb.core.prPred name="p21" org.eventb.core.predicate="dom(entryTMAOf)⊆dom(cpOf)"/>
