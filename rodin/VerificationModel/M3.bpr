        <org.eventb.core.prPred name="p1" org.eventb.core.predicate="∀a⦂AIRCRAFTS·a∈dom(mergeTime)∧a∈dom(brandof)∧mergeTime(a)&lt;lastMergeTime(PmsMerge(legPMS(legOf(a))))⇒lastMergeTime(PmsMerge(legPMS(legOf(a)))) − mergeTime(a)≥Separation_time(brandof(a) ↦ lastMergeBrand(PmsMerge(legPMS(legOf(a)))))"/>
        <org.eventb.core.prPred name="p336" org.eventb.core.predicate="∀l⦂SLEGS,w⦂WAYPOINT,x⦂ℤ,y⦂ℤ,z⦂ℤ,mx⦂ℤ,my⦂ℤ,mz⦂ℤ,dx⦂ℤ,dy⦂ℤ·w∈ran(legSeq(l))∧w ↦ (x ↦ y ↦ z)∈wppos∧PmsMerge(legPMS(l)) ↦ (mx ↦ my ↦ mz)∈pmpos∧dx=x − mx∧dy=y − my⇒wpDistMerge(w)∗wpDistMerge(w)≤dx∗dx+dy∗dy∧dx∗dx+dy∗dy&lt;(wpDistMerge(w)+1)∗(wpDistMerge(w)+1)"/>
        <org.eventb.core.prPred name="p2" org.eventb.core.predicate="∀x⦂WTC,y⦂WTC,z⦂WTC·x∈WTC∧y∈WTC∧z∈WTC⇒Separation_time(x ↦ z)≤Separation_time(x ↦ y)+Separation_time(y ↦ z)"/>
        <org.eventb.core.prPred name="p221" org.eventb.core.predicate="wpDistMerge∈WAYPOINT → ℕ1"/>
        <org.eventb.core.prPred name="p245" org.eventb.core.predicate="dom(lastEntryTime)=dom(lastEntryBrand)"/>
        <org.eventb.core.prPred name="p4" org.eventb.core.predicate="current_time≥legPointTime(aircraft)"/>
        <org.eventb.core.prPred name="p185" org.eventb.core.predicate="¬ExecutedT=Takingoff"/>
        <org.eventb.core.prPred name="p274" org.eventb.core.predicate="aircraft∈dom(cpOf)"/>
        <org.eventb.core.prPred name="p6" org.eventb.core.predicate="PmsMerge∈PMS ⇸ PM"/>
        <org.eventb.core.prPred name="p171" org.eventb.core.predicate="¬ExecutedL=Takingoff"/>
        <org.eventb.core.prPred name="p222" org.eventb.core.predicate="∀l⦂SLEGS,w⦂WAYPOINT,x⦂ℤ,y⦂ℤ,z⦂ℤ,mx⦂ℤ,my⦂ℤ,mz⦂ℤ,dx⦂ℤ,dy⦂ℤ·l∈SLEGS∧w∈WAYPOINT∧w∈ran(legSeq(l))∧w ↦ (x ↦ y ↦ z)∈wppos∧PmsMerge(legPMS(l)) ↦ (mx ↦ my ↦ mz)∈pmpos∧dx=x − mx∧dy=y − my⇒wpDistMerge(w)∗wpDistMerge(w)≤dx∗dx+dy∗dy∧dx∗dx+dy∗dy&lt;(wpDistMerge(w)+1)∗(wpDistMerge(w)+1)"/>
        <org.eventb.core.prPred name="p260" org.eventb.core.predicate="∀a⦂AIRCRAFTS,b⦂AIRCRAFTS·a∈dom(cpTime)∧b∈dom(cpTime)∧¬a=b∧a∈dom(brandof)∧b∈dom(brandof)∧cpOf(a)=cpOf(b)∧cpTime(a)≤cpTime(b)⇒cpTime(b) − cpTime(a)≥Separation_time(brandof(a) ↦ brandof(b))"/>
