        <org.eventb.core.prPred name="p9" org.eventb.core.predicate="∀a⦂AIRCRAFTS·a∈dom(mergeTime)∧a∈dom(brandof)∧mergeTime(a)=lastMergeTime(PmsMerge(legPMS(legOf(a))))⇒brandof(a)=lastMergeBrand(PmsMerge(legPMS(legOf(a))))"/>
        <org.eventb.core.prPred name="p219" org.eventb.core.predicate="¬NIRIF=SUTEX"/>
        <org.eventb.core.prPred name="p349" org.eventb.core.predicate="¬SORIN=SUGAD"/>
        <org.eventb.core.prPred name="p370" org.eventb.core.predicate="Small ↦ Large∈dom(Separation_time)"/>
        <org.eventb.core.prPred name="p13" org.eventb.core.predicate="∀l1⦂SLEGS,l2⦂SLEGS,i1⦂ℤ,i2⦂ℤ·l1∈SLEGS∧l2∈SLEGS∧l1≠l2∧legPMS(l1)=legPMS(l2)∧i1∈1 ‥ leglength(l1)∧i2∈1 ‥ leglength(l2)∧wpDistMerge(legSeq(l1)(i1))&lt;wpDistMerge(legSeq(l2)(i2))⇒legFL(l1)&gt;legFL(l2)"/>
        <org.eventb.core.prPred name="p126" org.eventb.core.predicate="¬Blocked=ReadyL"/>
