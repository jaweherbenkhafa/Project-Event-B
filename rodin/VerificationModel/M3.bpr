        <org.eventb.core.prPred name="p280" org.eventb.core.predicate="∀l⦂SLEGS,w⦂WAYPOINT,x⦂ℤ,y⦂ℤ,z⦂ℤ,mx⦂ℤ,my⦂ℤ,mz⦂ℤ,dx⦂ℤ,dy⦂ℤ·w∈ran(legSeq(l))∧w ↦ (x ↦ y ↦ z)∈wppos∧PmsMerge(legPMS(l)) ↦ (mx ↦ my ↦ mz)∈pmpos∧dx=x − mx∧dy=y − my⇒wpDistMerge(w)∗wpDistMerge(w)≤dx∗dx+dy∗dy∧dx∗dx+dy∗dy&lt;(wpDistMerge(w)+1)∗(wpDistMerge(w)+1)"/>
        <org.eventb.core.prPred name="p2" org.eventb.core.predicate="∀x⦂WTC,y⦂WTC,z⦂WTC·x∈WTC∧y∈WTC∧z∈WTC⇒Separation_time(x ↦ z)≤Separation_time(x ↦ y)+Separation_time(y ↦ z)"/>
