        <org.eventb.core.prPred name="p289" org.eventb.core.predicate="∀a⦂AIRCRAFTS,b⦂AIRCRAFTS·a∈dom(cpTime)∧b∈dom(cpTime)∧¬a=b∧a∈dom(brandof)∧b∈dom(brandof)∧cpOf(a)=cpOf(b)∧cpTime(a)≤cpTime(b)⇒cpTime(b) − cpTime(a)≥Separation_time(brandof(a) ↦ brandof(b))"/>
